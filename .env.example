# Optional. Without a key, the platform uses its deterministic offline narrator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional replacement for the generated synthetic canonical dataset.
SGW_DATA_PATH=data/synthetic_sgw.json

# Vite development origins allowed to call the backend.
SGW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
